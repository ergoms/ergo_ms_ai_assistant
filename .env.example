# URL для Ollama (локальный сервер для запуска языковых моделей)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Транспорт ollama_framework: local (ModuleBridge) или http (REST API)
OLLAMA_FRAMEWORK_TRANSPORT=local
OLLAMA_FRAMEWORK_API_BASE=

# Модель Ollama по умолчанию (например: mistral:7b, llama3:8b, qwen2:7b)
OLLAMA_DEFAULT_MODEL=mistral:7b

# Модель Ollama для генерации embeddings (векторных представлений) в RAG
OLLAMA_EMBEDDINGS_MODEL=embeddinggemma

# Использовать прямой API Ollama (обычно работает намного быстрее)
OLLAMA_USE_DIRECT_API=true

# Таймауты и параметры LLM-запросов (секунды / токены)
AI_ASSISTANT_REQUEST_TIMEOUT=180.0
AI_ASSISTANT_STREAM_TIMEOUT=300.0
AI_ASSISTANT_SQL_TOKENS=256
AI_ASSISTANT_COMMENTARY_TOKENS=192
AI_ASSISTANT_TEMPERATURE_SQL=0.08
AI_ASSISTANT_TEMPERATURE_COMMENTARY=0.24
AI_ASSISTANT_CONCURRENCY_LIMIT=8
AI_ASSISTANT_MAX_RETRIES=2
AI_ASSISTANT_KEEP_ALIVE=10m

# RAG (Retrieval-Augmented Generation)
RAG_ENABLED=true
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.0
RAG_MAX_CONTEXT_LENGTH=4000
