# URL для Ollama (локальный сервер для запуска языковых моделей)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Транспорт ollama_framework: local (ModuleBridge) или http (REST API)
OLLAMA_FRAMEWORK_TRANSPORT=local
OLLAMA_FRAMEWORK_API_BASE=

# auto / gpu / cpu — устройство inference для ai_assistant (переопределяет OLLAMA_COMPUTE_DEVICE).
# Пусто — наследовать настройку из modules/ollama_framework/.env (там по умолчанию auto).
AI_ASSISTANT_OLLAMA_COMPUTE_DEVICE=

# Модель Ollama по умолчанию (например: mistral:7b, llama3:8b, qwen2:7b)
OLLAMA_DEFAULT_MODEL=mistral:latest

# Модель Ollama для генерации embeddings (векторных представлений) в RAG
OLLAMA_EMBEDDINGS_MODEL=embeddinggemma

# Таймауты и параметры LLM-запросов (секунды / токены)
AI_ASSISTANT_REQUEST_TIMEOUT=180.0
AI_ASSISTANT_STREAM_TIMEOUT=300.0
AI_ASSISTANT_SQL_TOKENS=256
AI_ASSISTANT_COMMENTARY_TOKENS=192
AI_ASSISTANT_TEMPERATURE_SQL=0.08
AI_ASSISTANT_TEMPERATURE_COMMENTARY=0.24
# Сколько chat/embed одновременно в процессе API (1–2 на слабой GPU/CPU).
# Также лимит параллельной индексации RAG в очереди Celery ai_assistant.
# Не путать с OLLAMA_CONCURRENCY_LIMIT в ollama_framework.
AI_ASSISTANT_CONCURRENCY_LIMIT=2
AI_ASSISTANT_MAX_RETRIES=2
AI_ASSISTANT_KEEP_ALIVE=10m

# RAG (Retrieval-Augmented Generation)
RAG_ENABLED=true
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.25
RAG_MAX_CONTEXT_LENGTH=6000

# Пользовательский корпус функционала сайта (меню, UI-строки, guides)
RAG_SYSTEM_CORPUS_ENABLED=true
RAG_INCLUDE_SYSTEM_IN_CHAT=true
RAG_SYSTEM_CORPUS_MAX_FILE_BYTES=1000000
# Ежедневный sync корпуса через Celery Beat (ergoms start-beat + start-worker)
RAG_SYSTEM_CORPUS_BEAT_ENABLED=true

# Частота загрузок media_api по сценарию (класс квоты по target_dir).
# Не подменяет глобальные MEDIA_API_UPLOAD_RATE / MEDIA_API_UPLOAD_RATE_ADMIN.
# Потолок установки — MEDIA_API_UPLOAD_RATE_CEILING (env/media.env).
AI_ASSISTANT_UPLOAD_RATE_RAG=60/minute
AI_ASSISTANT_UPLOAD_RATE_CHAT=20/minute
